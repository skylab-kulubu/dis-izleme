# SKY LAB dış izleme: durum sayfası + nabız deposu (tek Worker). Bu bir ŞABLON: hesap, KV kimliği, özet ve geçiş adları yayın
# sırasında doldurulur (ops/wizards/dis-izleme-2026-11-24-wizard.sh; doldurulmuş kopya depoya girmez). Hiçbiri sır değil:
# hesap ve KV kimlikleri ad, özet sunucudaki belirtecin SHA-256 özeti (belirtecin kendisi sunucudan çıkmaz).
# Asıl ad status.yildizskylab.com (sayfa + /heartbeat). Geçişte (--eski-sil'e kadar) wizard ESKI_ADLAR'a durum. ve nabiz.'yı
# yazar ve iki adın rotasını sona ekler; --eski-sil değişkeni boşaltıp rotaları eklemeden yayımlar (Cloudflare iki adı kaldırır).
name = "skylab-durum"
account_id = "@@HESAP@@"
main = "worker.js"
compatibility_date = "2026-10-01"
workers_dev = false
preview_urls = false

[assets]
directory = "./sayfa"
binding = "ASSETS"
run_worker_first = true

[[kv_namespaces]]
binding = "NABIZ"
id = "@@KV_ID@@"

[vars]
NABIZ_OZET = "@@OZET@@"
VERI_KOK = "https://raw.githubusercontent.com/skylab-kulubu/dis-izleme/veri"
ESKI_ADLAR = "@@ESKI_ADLAR@@"

[[routes]]
pattern = "status.yildizskylab.com"
custom_domain = true
